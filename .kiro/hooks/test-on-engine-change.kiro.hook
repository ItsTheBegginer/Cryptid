{
  "enabled": true,
  "name": "Test On Engine Change",
  "description": "Run the test suite whenever engine code or tests are saved.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/engine/**/*.ts", "tests/**/*.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm test`. If anything fails, explain the cause and fix it without weakening the property-based tests."
  }
}
